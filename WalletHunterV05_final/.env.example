# SAFE TEMPLATE ONLY. Never put working secrets into this tracked example.
# See ../docs/ENVIRONMENT.md for actual code defaults and all limitations.
# Copy/configure separately; this example intentionally cannot start a bot.

# REQUIRED for the Telegram bot: separate test application/bot credentials.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

# OPTIONAL legacy field: currently NOT an access-control allowlist.
TELEGRAM_OWNER_ID=0

# Deliberately safer than the code default MAINNET. Use exactly TESTNET.
# An unknown HL_MODE currently falls back to MAINNET in the clients.
HL_MODE=TESTNET

# Copy-engine flag only, NOT a global ban on manual/AI-confirmed real orders.
# Test isolation also requires no funded-account keys or production session.
AUTO_TRADING=false

# REQUIRED: separate Fernet key for isolated test state. Keep it secret.
# Restoring existing encrypted state requires its ORIGINAL matching key.
# Never overwrite a working MASTER_KEY with a newly generated key on restart.
MASTER_KEY=

# Existing copy-engine defaults, not a promise of safe or profitable trading.
MAX_LEVERAGE=20
MAX_POSITION_PCT=100
# 0 DISABLES the total planned exposure cap; it does not block trading.
MAX_TOTAL_EXPOSURE_USD=25000
MAX_SLIPPAGE_PCT=0.5
ENTRY_PRICE_TOLERANCE_PCT=0.5

# Seconds to pause after a complete watcher pass, not a per-user latency SLA.
WATCH_INTERVAL=3

# Replace with your own HTTPS Mini App URL before using a test bot.
# Reserved invalid domain: intentionally not a working/public deployment.
WEBAPP_URL=https://your-mini-app.example.invalid/
